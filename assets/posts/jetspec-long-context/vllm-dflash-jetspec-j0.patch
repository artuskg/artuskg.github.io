+@triton.jit
+def _ctx_pool_write_kernel(
+    target_input_ids_ptr,
+    target_positions_ptr,
+    target_query_start_loc_ptr,
+    idx_mapping_ptr,
+    last_sampled_ptr,
+    next_prefill_tokens_ptr,
+    num_sampled_ptr,
+    num_rejected_ptr,
+    ctx_pool_ptr,
+    ctx_pool_stride,
+    max_model_len,
+    BLOCK_SIZE: tl.constexpr,
+):
+    req_idx = tl.program_id(0)
+    block_idx = tl.program_id(1)
+    req_state_idx = tl.load(idx_mapping_ptr + req_idx)
+    base = ctx_pool_ptr + req_state_idx.to(tl.int64) * ctx_pool_stride
+    ctx_start = tl.load(target_query_start_loc_ptr + req_idx)
+    ctx_end = tl.load(target_query_start_loc_ptr + req_idx + 1)
+    valid_ctx_end = ctx_end - tl.load(num_rejected_ptr + req_idx)
+    num_valid_ctx = valid_ctx_end - ctx_start
+    j = block_idx * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+    m = j < num_valid_ctx
+    pos = tl.load(target_positions_ptr + ctx_start + j, mask=m, other=0)
+    tok = tl.load(target_input_ids_ptr + ctx_start + j, mask=m, other=0)
+    tl.store(base + pos, tok, mask=m & (pos < max_model_len))
+    if block_idx == 0:
+        if tl.load(num_sampled_ptr + req_idx) > 0:
+            bonus = tl.load(last_sampled_ptr + req_state_idx).to(tl.int32)
+        else:
+            bonus = tl.load(next_prefill_tokens_ptr + req_state_idx).to(tl.int32)
+        bpos = tl.load(target_positions_ptr + valid_ctx_end - 1) + 1
+        tl.store(base + bpos, bonus, mask=bpos < max_model_len)
+
